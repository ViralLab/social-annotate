{
  "x": {
    "shared": {
      "appRoot": "#doc",
      "observerFilter": {
        "attributes": true,
        "childList": true,
        "subtree": true,
        "attributeFilter": [
          "role"
        ]
      }
    },
    "account": {
      "userDisplayName": "strong[data-aria-label-part]",
      "userHandle": "span[data-aria-label-part] > b",
      "userAvatar": "a[data-user-id] > img",
      "userProfileAvatar": "a[data-resolved-url-large] > img",
      "userProfileSchema": "script[data-testid=\"UserProfileSchema-test\"]",
      "userBanner": "div#page-container > div > div > div > div > img",
      "userBio": "h2[dir='ltr'] + p[dir='ltr']",
      "userHeadline": null,
      "userVerified": "a[href*='/help/verified']",
      "userFollowers": "a[data-nav='followers']",
      "userFollowing": "a[data-nav='following']",
      "userConnections": null,
      "userLocation": "p[dir='ltr'] + div > div:nth-of-type(1) > span[dir='ltr']",
      "userJoinDate": "span[dir='ltr'][title*=' - ']",
      "userUrl": "a[rel*='me']",
      "userLink": null
    },
    "post": {
      "postContainer": "div[data-tweet-id]",
      "postText": "p[lang]",
      "postImage": "div[data-image-url] img",
      "postVideo": "div[data-playable-media-url]",
      "postTimestamp": "a[href*='/status/'] > span[data-time-ms]",
      "postLink": null,
      "cardWrapper": "div[data-card2-name]",
      "conversationMessages": null,
      "messageContainer": null,
      "copyableText": null,
      "metricsReply": "button[data-modal='ProfileTweet-reply']",
      "metricsRepost": "button[data-modal='ProfileTweet-retweet']",
      "metricsLike": "button[aria-describedby*='favorite-count']",
      "metricsBookmark": null,
      "metricsViews": null,
      "metricsQuote": null,
      "metricsViewsPattern": "views?"
    }
  }
}