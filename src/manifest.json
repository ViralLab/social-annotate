{
  "name": "Social Annotate",
  "version": "1.0",
  "description": "Social Annotate application developed by Ali Najafi, Ismail Uluturk and Onur Varol",
  "permissions": [
    "activeTab",
    "declarativeContent",
    "storage",
    "downloads",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://twitter.com/*",
    "*://instagram.com/*",
    "*://www.instagram.com/*",
    "*://x.com/*",
    "*://bsky.app/*",
    "*://bsky.social/*",
    "*://web.whatsapp.com/*",
    "*://web.telegram.org/*",
    "*://truthsocial.com/*",
    "*://www.linkedin.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "sandbox": {
    "pages": [
      "sandbox/survey.html"
    ]
  },
  "action": {
    "default_title": "social-annotate",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/ca16.png",
      "32": "images/ca32.png",
      "48": "images/ca48.png",
      "128": "images/ca128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content-scripts/x/inject-api.js"
      ]
    },
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*",
        "file:///*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "run_at": "document_end",
      "exclude_matches": [
        "*://twitter.com/settings/*",
        "*://x.com/settings/*"
      ],
      "css": [
        "content-scripts/x/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/x/inject.js"
      ]
    },
    {
      "matches": [
        "*://instagram.com/*",
        "*://www.instagram.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content-scripts/instagram/inject-api.js"
      ]
    },
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "run_at": "document_end",
      "css": [
        "content-scripts/instagram/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/instagram/inject.js"
      ]
    },
    {
      "matches": [
        "*://bsky.app/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content-scripts/bluesky/inject-api.js"
      ]
    },
    {
      "matches": [
        "*://bsky.app/*",
        "file:///*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "run_at": "document_end",
      "css": [
        "content-scripts/bluesky/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/bluesky/inject.js"
      ]
    },
    {
      "matches": [
        "*://web.whatsapp.com/*",
        "file:///*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "run_at": "document_end",
      "css": [
        "content-scripts/bluesky/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/whatsapp/inject.js"
      ]
    },
    {
      "matches": [
        "*://web.telegram.org/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content-scripts/telegram/inject-api.js"
      ]
    },
    {
      "matches": [
        "*://web.whatsapp.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content-scripts/whatsapp/inject-api.js"
      ]
    },
    {
      "matches": [
        "*://web.telegram.org/*",
        "file:///*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "run_at": "document_end",
      "css": [
        "content-scripts/bluesky/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/telegram/inject.js"
      ]
    },
    {
      "matches": [
        "*://truthsocial.com/*",
        "file:///*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "run_at": "document_end",
      "css": [
        "content-scripts/truthsocial/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/truthsocial/inject.js"
      ]
    },
    {
      "matches": [
        "*://www.linkedin.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content-scripts/linkedin/inject-api.js"
      ]
    },
    {
      "matches": [
        "*://www.linkedin.com/*",
        "file:///*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "run_at": "document_end",
      "css": [
        "content-scripts/linkedin/inject.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/linkedin/inject.js"
      ]
    }
  ],
  "icons": {
    "16": "images/ca16.png",
    "32": "images/ca32.png",
    "48": "images/ca48.png",
    "128": "images/ca128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox/survey.html",
        "selectors.json",
        "content-scripts/instagram/inject.css",
        "content-scripts/x/inject.css",
        "content-scripts/bluesky/inject.css",
        "content-scripts/telegram/inject.css",
        "content-scripts/whatsapp/inject.css",
        "content-scripts/truthsocial/inject.css",
        "content-scripts/linkedin/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "manifest_version": 3
}