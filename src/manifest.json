{
  "name": "Content Annotator",
  "version": "1.0",
  "description": "Content annotator application developed by Ismail Uluturk and Onur Varol",
  "permissions": ["activeTab", "declarativeContent", "storage", "downloads", "tabs", "webNavigation"],
  "host_permissions": ["*://twitter.com/*", "*://instagram.com/*", "*://www.instagram.com/*", "*://x.com/*"],
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "sandbox": {
    "pages": ["sandbox/survey.html"]
  },
  "action": {
    "default_title": "social-annotate",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/ca16.png",
      "32": "images/ca32.png",
      "48": "images/ca48.png",
      "128": "images/ca128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://twitter.com/*", "*://x.com/*"],
      "run_at": "document_end",
      "exclude_matches": ["*://twitter.com/settings/*", "*://x.com/settings/*"],
      "css": [
        "content-scripts/twitter/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/twitter/inject.js"
      ]
    },
    {
      "matches": ["*://www.instagram.com/*"],
      "run_at": "document_end",
      "css": [
        "content-scripts/instagram/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "js": [
        "dep/analytics.js",
        "dep/jsonform/deps/jquery.min.js",
        "dep/jsonform/deps/underscore.js",
        "dep/jsonform/deps/opt/jsv.js",
        "dep/jsonform/lib/jsonform.js",
        "content-scripts/shared/shared.js",
        "content-scripts/instagram/inject.js"
      ]
    }
  ],
  "icons": {
    "16": "images/ca16.png",
    "32": "images/ca32.png",
    "48": "images/ca48.png",
    "128": "images/ca128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox/survey.html",
        "content-scripts/instagram/inject.css",
        "content-scripts/twitter/inject.css",
        "dep/jsonform/deps/opt/bootstrap.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "manifest_version": 3
}
